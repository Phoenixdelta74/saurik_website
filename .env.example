# SAURIK IT website - server-side environment for the AI chat & voice functions (api/*).
# Copy to .env.local and fill in real values. Never commit real keys (.env* is gitignored).
# These are read only by the serverless functions (vercel dev / Vercel deployment),
# never by the browser bundle. Set the same values in Vercel > Project > Settings > Environment Variables.

# --- Provider keys (at least one is required) ---
# Text chat uses OpenRouter when this key is set.
OPENROUTER_API_KEY=
# Voice chat uses OpenAI when this key is set; also powers the /api/tts fallback voice (e.g. Bengali).
OPENAI_API_KEY=
# Optional alternative provider.
ANTHROPIC_API_KEY=

# --- Models (optional; defaults shown) ---
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Routing (optional) ---
# Force one provider for both text and voice: openai | openrouter | anthropic | ollama
# Leave empty to use text -> OpenRouter, voice -> OpenAI.
LLM_PROVIDER=

# --- Local Ollama (optional, only with LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Site / security (optional) ---
# Sent to OpenRouter as HTTP-Referer.
SITE_URL=https://www.saurikit.in
# Extra domains allowed to call /api/* (comma-separated). saurikit.in, www.saurikit.in,
# localhost and the deployment's own host are always allowed.
ALLOWED_ORIGINS=
