{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/track", "destination": "/track/index.html" },
    { "source": "/track/", "destination": "/track/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
